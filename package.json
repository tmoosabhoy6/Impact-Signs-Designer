{
  "name": "plaque-proof-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Impact Signs internal tool: plaque concepts, customer proofs and vector production files.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "samples": "tsx scripts/make-samples.ts"
  },
  "dependencies": {
    "@fontsource/archivo-narrow": "^5.3.0",
    "@fontsource/arimo": "^5.3.0",
