    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/libre-franklin": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/tinos": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "imagetracerjs": "^1.2.6",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "openai": "^7.28.0",
    "opentype.js": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
