# Copy to .env for local use. On Render these are set in the dashboard (render.yaml lists them).
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst-2026-09-08
OPENAI_VISION_MODEL=gpt-5.4-mini
# Reads designer Fix instructions into a checked plan (falls back to OPENAI_VISION_MODEL)
OPENAI_PLANNER_MODEL=gpt-5.4
# Image quality for concepts: low | medium | high | xhigh | max
IMAGE_QUALITY=high
# Longest edge of generated concept images in pixels (multiple of 16, max 2560 recommended)
IMAGE_LONG_EDGE=1536
# Sign-in accounts (username + password) live in Supabase: see supabase/migrations.
# Project URL and publishable key from Supabase > Project Settings > API Keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Jobs and upscales made before sign-in accounts existed belong to this username.
LEGACY_JOBS_OWNER=taher
# Older setup without Supabase: one shared team password plus each person's name.
APP_PASSWORD=
SESSION_SECRET=
DATA_DIR=./data-store
# 1 = fake image generator (no OpenAI calls, no cost). 0 = real OpenAI.
MOCK_AI=0
MAX_IMAGE_CALLS_PER_PROJECT=40
DAILY_BUDGET_USD=40
# Estimated prices in USD per 1M tokens, used for the cost display and the daily budget.
PRICE_TEXT_IN=5
PRICE_IMAGE_IN=8
PRICE_IMAGE_OUT=30
PORT=8080
